<% layout("/layouts/boilerplate.ejs") %>
<div class="row mt-4">
  <div class="col-8 offset-3">
    <h3 class="mb-3"><%= listing.title %></h3>
  </div>
  <div class="card listing-card col-6 offset-3 show-card">
    <img
      src="<%= listing.image %>"
      class="card-img-top show-img"
      alt="listing_image"
    />
    <div class="card-body">
      <p class="card-text">
        <i>Owned By: <%= listing.owner.username %></i>
      </p>

      <p class="card-text">
        <b> &#8377; <%= listing.price.toLocaleString("en-IN") %> </b><br />
      </p>
      <p class="card-text"><%= listing.description %></p>
      <p class="card-text"><%= listing.location %>, <%= listing.country %></p>
      <p class="card-text"><%= listing.image %></p>
    </div>
  </div>
  <% if(curUser && curUser._id.equals(listing.owner._id)) { %>
  <div class="btns">
    <a
      class="btn btn-dark add-btn col-1 offset-3"
      href="/listings/<%= listing._id %>/edit"
      >Edit
    </a>
    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
      <button class="btn btn-dark offset-5">Delete</button>
    </form>
  </div>
  <% } %>

  <div class="col-8 offset-3 my-3">
    <hr />
    <h4>Leave a Review</h4>
    <form
      class="needs-validation"
      action="/listings/<%= listing._id %>/reviews"
      method="post"
      novalidate
    >
      <div class="my-3">
        <label class="form-label" for="rating">Rating</label>
        <input
          class="form-range"
          type="range"
          name="review[rating]"
          min="1"
          max="5"
          id="rating"
          required
        />
      </div>
      <div class="my-3">
        <label class="form-label" for="comment">Comment</label>
        <textarea
          class="form-control"
          name="review[comment]"
          id="comment"
          rows="5"
          cols="30"
          required
          placeholder="Write your Experience"
        ></textarea>
        <div class="invalid-feedback">Write a comment</div>
      </div>
      <button class="btn btn-outline-dark">Submit</button>
    </form>

    <hr />

    <h3>All Review</h3>
    <div class="row">
      <% for (const review of listing.reviews) { %>
      <div class="card col-5 ms-3 mb-3 p-2">
        <h5 class="card-title">John Doe</h5>
        <span class="card-text"><%= review.comment %></span>
        <p class="card-text"><%= review.rating %> stars</p>

        <form
          action="/listings/<%= listing._id %>/reviews/<%= review._id%>?_method=DELETE"
          method="post"
        >
          <button class="btn btn-dark">Delete</button>
        </form>
      </div>
      <%} %>
    </div>
  </div>
</div>
